# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillsboard
# Direct connection used by Drizzle migrations. For a local Postgres server
# this can match DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/skillsboard
BETTER_AUTH_SECRET=replace-with-a-secret-from-openssl-rand-base64-32

# Required by the daily Vercel Cron that purges expired collection releases.
# Generate a dedicated value with: openssl rand -hex 32
CRON_SECRET=

# Activation email sequence, run by the daily Vercel Cron at 13:00 UTC.
# Off unless it reads exactly "true": without it the cron reports who would
# have been emailed and sends nothing.
ACTIVATION_EMAILS_ENABLED=false
# ISO date the sequence was switched on. Teams created before it anchor their
# 14 day window here, which is the one time retroactive pass. Leave empty and
# only teams created inside the window qualify.
ACTIVATION_BACKFILL_STARTED_AT=

# Production analytics: configure only for the Production environment in Vercel.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Recommended for local auth callbacks
BETTER_AUTH_URL=http://localhost:3000

# Required outside development for email OTP (also used for invitation emails).
# In development, OTP emails are skipped and any 6-digit code works; these can stay empty.
# EMAIL_FROM must use a domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=Skills Board <login@your-verified-domain.com>

# Required for the signed Resend delivery-event endpoint at /api/webhooks/resend.
# Subscribe it to email.sent, email.bounced, email.complained,
# email.suppressed, and contact.updated.
RESEND_WEBHOOK_SECRET=

# Required in Vercel Production: at least 32 random bytes encoded as base64 or
# hex, used as the root for hashed identities and encrypted unsubscribe links.
# BETTER_AUTH_SECRET is a local/self-host fallback.
EMAIL_PRIVACY_SECRET=
# Optional during a planned rotation: JSON array of retained base64/hex roots.
EMAIL_PRIVACY_SECRET_PREVIOUS=[]

# Required outside development for the email capture rate limit: an Upstash
# Redis database, created in a region close to the deployment. On Vercel, add
# it from the Marketplace and connect it to the project; the integration writes
# these two (plus a read-only token this app does not use) by itself.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Self-hosting against a database from console.upstash.com: set these instead.
# The client reads them before the KV_ pair above, so a Vercel project leaves
# them empty. Without a complete pair the capture form keeps working and is
# not rate limited.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: increases GitHub API rate limits
GITHUB_TOKEN=

# Optional: injected automatically by Vercel for skills.sh discovery
VERCEL_OIDC_TOKEN=
